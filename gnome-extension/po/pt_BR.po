#: indicator.js:18
msgid "No keyring: History is kept in memory only"
msgstr "Sem chaveiro: o Histórico fica só na memória"

#: indicator.js:19
msgid "History can’t be saved: kept in memory only"
msgstr "Não é possível salvar o Histórico: ele fica só na memória"

#: indicator.js:20
msgid "The saved History couldn’t be opened and was erased"
msgstr "O Histórico salvo não pôde ser aberto e foi apagado"

#: indicator.js:21
msgid "Some saved Items couldn’t be read and were erased"
msgstr "Alguns Itens salvos não puderam ser lidos e foram apagados"

#: indicator.js:22
msgid "Saving the History failed; retrying on the next copy"
msgstr "Falha ao salvar o Histórico; nova tentativa na próxima cópia"

#: indicator.js:45
msgid "Open History"
msgstr "Abrir Histórico"

#: indicator.js:46
msgid "Settings"
msgstr "Configurações"

#: indicator.js:47
msgid "Pause Capture"
msgstr "Pausar captura"

#: indicator.js:73
msgid "Copyveil, capture paused"
msgstr "Copyveil, captura pausada"

#: indicator.js:74
msgid "Copyveil, a Secret is in memory"
msgstr "Copyveil, há um Segredo na memória"

#: indicator.js:86
msgid "Copyveil isn’t running"
msgstr "O Copyveil não está em execução"
