<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Copyveil</name>
  <summary>Clipboard history that forgets your secrets</summary>
  <description>
    <p>
      Copyveil keeps a searchable history of what you copy. Passwords, API keys
      and tokens are masked, kept in memory only, and erased after a short time.
      Everything else is encrypted on disk with a key from your system keyring.
    </p>
    <ul>
      <li>Opens with a shortcut and works from the keyboard</li>
      <li>Masks secrets from password managers and detects tokens by their content</li>
      <li>Never writes secrets to disk</li>
      <li>Pin the things you paste every day</li>
    </ul>
  </description>
  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <developer id="io.github.joaoferrete">
    <name translate="no">João Ferrete</name>
  </developer>
  <url type="homepage">https://github.com/joaoferrete/copyveil</url>
  <url type="bugtracker">https://github.com/joaoferrete/copyveil/issues</url>
  <url type="vcs-browser">https://github.com/joaoferrete/copyveil</url>
  <content_rating type="oars-1.1"/>
  <keywords>
    <keyword>clipboard</keyword>
    <keyword>history</keyword>
    <keyword>secrets</keyword>
    <keyword>password</keyword>
  </keywords>
  <releases>
    <release version="0.1.0" date="2026-11-18" type="stable">
      <description>
        <p>The first release, for GNOME.</p>
        <ul>
          <li>Secrets from password managers are masked, kept in memory only, and erased with the clipboard after 30 seconds</li>
          <li>Tokens and keys are detected by their content and erased after 15 minutes</li>
          <li>Everything else is encrypted on disk with a key from the system keyring</li>
          <li>A popup on Super+Shift+V with search, Pins, and paste by number</li>
          <li>Rich text keeps its formatting; Shift+Enter pastes plain text</li>
          <li>English and Brazilian Portuguese</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
