#: data/io.github.joaoferrete.Copyveil.desktop.in:3
#: data/io.github.joaoferrete.Copyveil.metainfo.xml.in:7
msgid "Clipboard history that forgets your secrets"
msgstr "Histórico da área de transferência que esquece seus segredos"

#: data/io.github.joaoferrete.Copyveil.desktop.in:9
msgid "clipboard;history;paste;secrets;password;token;"
msgstr "área de transferência;histórico;colar;segredos;senha;token;clipboard;"

#: data/io.github.joaoferrete.Copyveil.metainfo.xml.in:9
msgid ""
"Copyveil keeps a searchable history of what you copy. Passwords, API keys "
"and tokens are masked, kept in memory only, and erased after a short time. "
"Everything else is encrypted on disk with a key from your system keyring."
msgstr "O Copyveil guarda um histórico pesquisável do que você copia. Senhas, chaves de API e tokens ficam mascarados, só na memória, e são apagados depois de pouco tempo. O resto é criptografado no disco com uma chave do chaveiro do sistema."

#: data/io.github.joaoferrete.Copyveil.metainfo.xml.in:15
msgid "Opens with a shortcut and works from the keyboard"
msgstr "Abre com um atalho e funciona pelo teclado"

#: data/io.github.joaoferrete.Copyveil.metainfo.xml.in:16
msgid ""
"Masks secrets from password managers and detects tokens by their content"
msgstr "Mascara segredos vindos de gerenciadores de senhas e detecta tokens pelo conteúdo"

#: data/io.github.joaoferrete.Copyveil.metainfo.xml.in:17
msgid "Never writes secrets to disk"
msgstr "Nunca grava segredos no disco"

#: data/io.github.joaoferrete.Copyveil.metainfo.xml.in:18
msgid "Pin the things you paste every day"
msgstr "Fixe o que você cola todo dia"

#: data/io.github.joaoferrete.Copyveil.metainfo.xml.in:30
msgid "clipboard"
msgstr "área de transferência"

#: data/io.github.joaoferrete.Copyveil.metainfo.xml.in:31
msgid "history"
msgstr "histórico"

#: data/io.github.joaoferrete.Copyveil.metainfo.xml.in:32
msgid "secrets"
msgstr "segredos"

#: data/io.github.joaoferrete.Copyveil.metainfo.xml.in:33
msgid "password"
msgstr "senha"

#: data/io.github.joaoferrete.Copyveil.metainfo.xml.in:38
msgid "The first release, for GNOME."
msgstr "A primeira versão, para o GNOME."

#: data/io.github.joaoferrete.Copyveil.metainfo.xml.in:40
msgid ""
"Secrets from password managers are masked, kept in memory only, and erased "
"with the clipboard after 30 seconds"
msgstr "Segredos de gerenciadores de senhas ficam mascarados, só na memória, e são apagados junto com a área de transferência depois de 30 segundos"

#: data/io.github.joaoferrete.Copyveil.metainfo.xml.in:41
msgid ""
"Tokens and keys are detected by their content and erased after 15 minutes"
msgstr "Tokens e chaves são detectados pelo conteúdo e apagados depois de 15 minutos"

#: data/io.github.joaoferrete.Copyveil.metainfo.xml.in:42
msgid "Everything else is encrypted on disk with a key from the system keyring"
msgstr "O resto é criptografado no disco com uma chave do chaveiro do sistema"

#: data/io.github.joaoferrete.Copyveil.metainfo.xml.in:43
msgid "A popup on Super+Shift+V with search, Pins, and paste by number"
msgstr "Um popup no Super+Shift+V com busca, Fixados e colar pelo número"

#: data/io.github.joaoferrete.Copyveil.metainfo.xml.in:44
msgid "Rich text keeps its formatting; Shift+Enter pastes plain text"
msgstr "Texto formatado mantém a formatação; Shift+Enter cola texto puro"

#: data/io.github.joaoferrete.Copyveil.metainfo.xml.in:45
msgid "English and Brazilian Portuguese"
msgstr "Inglês e português do Brasil"