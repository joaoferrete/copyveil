{
  "$description": "Copyveil design tokens. Single source of truth (docs/adr/0003-*). Edit this file, then run `python3 tools/tokens.py` to regenerate data/ui/style.css and data/ui/style-dark.css. CI runs `python3 tools/tokens.py --check`.",
  "color": {
    "ink":        { "light": "#191C22", "dark": "#E7E9ED", "role": "Primary text" },
    "ink-2":      { "light": "#575D69", "dark": "#9AA1AE", "role": "Secondary text, metadata" },
    "sheet":      { "light": "#FFFFFF", "dark": "#181B21", "role": "Content surface behind Items" },
    "slate":      { "light": "#34465F", "dark": "#A7B8D3", "role": "Brand. ExpiryRing, onboarding, focus within brand surfaces" },
    "slate-soft": { "light": "#DCE3EC", "dark": "#253042", "role": "Brand tint surface (onboarding art)" },
    "tint":       { "light": "#8C9CB3", "dark": "#5E6E88", "role": "Security-tint pattern lines" },
    "kraft":      { "light": "#C49A5C", "dark": "#C9A26A", "role": "App icon only" },
    "marker":     { "light": "#F1DF74", "dark": "#E2D068", "role": "Search match highlight only" },
    "on-marker":  { "light": "#191C22", "dark": "#191C22", "role": "Text on marker" }
  },
  "sensitivity": {
    "secret":    { "light": "#262B35", "dark": "#D5DAE3", "shape": "solid", "role": "Secret Mask: solid bar, fixed width" },
    "suspected": { "light": "#262B35", "dark": "#AEB7C6", "shape": "hatch", "role": "Suspected Mask: 45deg hatch, edges of the value visible" }
  },
  "mask": {
    "secret-width-ch": 13,
    "hatch-line-px": 1.6,
    "hatch-gap-px": 4,
    "reveal-max-ms": 5000
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32 },
  "radius": { "chip": 4, "row": 8, "control": 9, "window": 14 },
  "motion": {
    "veil-draw":   { "ms": 280, "easing": "cubic-bezier(.2,.7,.2,1)" },
    "reveal-peel": { "ms": 170, "easing": "ease-out" },
    "expiry-dissolve": { "ms": 300, "easing": "ease-in" },
    "expiry-collapse": { "ms": 460, "easing": "ease-in" },
    "carbon-copy": { "ms": 360, "easing": "ease-out" }
  },
  "type": {
    "ui": "Adwaita Sans",
    "item": "Adwaita Mono"
  },
  "contrast": [
    { "fg": "color.ink",       "bg": "color.sheet",  "min": 4.5 },
    { "fg": "color.ink-2",     "bg": "color.sheet",  "min": 4.5 },
    { "fg": "color.slate",     "bg": "color.sheet",  "min": 4.5 },
    { "fg": "color.on-marker", "bg": "color.marker", "min": 4.5 },
    { "fg": "sensitivity.secret",    "bg": "color.sheet", "min": 3.0 },
    { "fg": "sensitivity.suspected", "bg": "color.sheet", "min": 3.0 }
  ]
}
